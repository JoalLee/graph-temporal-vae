      "HNO2": 0.01,
      "HNO3": 0.05,
      "Hg": 0.00011999999999999999,
      "In": 0.0031,
      "K": 0.0012,
      "K+": 0.08,
      "La": 0.00035999999999999997,
      "Mg2+": 0.05,
      "Mn": 0.00014000000000000001,
      "NH3": 0.1,
      "NH4+": 0.08,
      "NO2-": 0.05,
      "NO3-": 0.01,
      "Na+": 0.05,
      "Nb": 0.00041,
      "Ni": 9.6e-05,
      "Optical_EC": 0.015,
      "Optical_OC": 0.3,
      "P": 0.0052,

{
  "timestamp_col": "time",
  "modality_files": {
    "chemistry": [
      "data/iop_clean/chem.csv"
    ],
    "psd": [
      "data/iop_clean/psd_basic_qc.csv"
    ],
    "meteorology": [
      "data/iop_clean/met.csv"
    ]
  },
  "add_time_cyclical_features": true,
  "preprocessing": {
    "chemistry": {
      "transform": "log1p",
      "scaler": "standard",
      "output_transform": "log1p"
    },
    "psd": {
      "transform": "log1p",
      "scaler": "robust",
      "output_transform": "log1p"
    },
    "meteorology": {
      "transform": "none",
      "scaler": "standard",
      "output_transform": "none"
    },
    "fit_scope": "full",
    "aux_mask_channel": true
  },
  "expected_frequency": "1h",
  "time_grid_policy": "strict",
  "duplicate_timestamp_policy": "error",
  "window_size": 48,
  "stride": 4,
  "val_fraction": 0.0,
  "batch_size": 32,
  "epochs": 200,
  "lr": 0.001,
  "lr_min": 1e-06,
  "weight_decay": 1e-05,
  "patience": 200,
  "train_loader_num_workers": 2,
  "val_loader_num_workers": 2,
  "pin_memory": true,
  "persistent_workers": true,
  "loader_prefetch_factor": 2,
  "dynamic_masking_mode": "block",
  "dynamic_mask_scope": "timeline_epoch",
  "dynamic_mask_target_ratio": 0.15,
  "dynamic_mask_mean_duration": 24.0,
  "dynamic_mask_std_duration": 12.0,
  "dynamic_mask_min_duration": 3,
  "dynamic_mask_max_duration": 48,
  "dynamic_mask_chem_blocks": 1,
  "dynamic_mask_psd_blocks": 1,
  "selection_mask_mode": "block",
  "selection_mask_ratio": 0.15,
  "train_ho_enabled": false,
  "selection_val_seed": 100003,
  "shared_full_heldout_mask": true,
  "validation_metric": "ho_mse",
  "full_data_refit_epochs": 0,
  "full_data_refit_lr": null,
  "full_data_refit_patience": null,
  "use_adaptive_lr": true,
  "lr_reduce_factor": 0.5,
  "lr_reduce_patience": 25,
  "lr_warmup_epochs": 40,
  "kl_warmup_epochs": 50,
  "kl_strategy": "cosine",
  "prior_type": "gaussian",
  "use_gnll": true,
  "use_student_t_nll": true,
  "val_crps_dist_type": "student_t",
  "loss_normalization": "observed_mean",
  "chem_feature_weight": 6.0,
  "psd_feature_weight": 1.0,
  "use_amp": true,
  "amp_dtype": "bfloat16",
  "seed": 0,
  "model_kwargs": {
    "latent_dim": 128,
    "hidden_dims": [
      256,
      256,
      256
    ],
    "encoder_layers": 4,
    "decoder_layers": 4,
    "n_graph_heads": 4,
    "dropout": 0.15,
    "heteroscedastic": true,
    "use_realnvp": true,
    "realnvp_layers": 4
  },
  "censoring": {
    "enabled": true,
    "detect": "zero",
    "input_fill": "half_threshold",
    "loss": "tobit",
    "thresholds": {
      "Ag": 0.0019,
      "Al": 0.1,
      "As": 6.3e-05,
      "Au": 0.0001,
      "Ba": 0.00039,
      "Bi": 0.00013000000000000002,

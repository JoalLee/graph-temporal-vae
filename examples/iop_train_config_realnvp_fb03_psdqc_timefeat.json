      "Pb": 0.00013000000000000002,
      "Pd": 0.0022,
      "Rb": 0.00019,
      "S": 0.0032,
      "SO42-": 0.05,
      "Sb": 0.0052,
      "Se": 8.1e-05,
      "Si": 0.018,
      "Sn": 0.0040999999999999995,
      "Sr": 0.00022,
      "Thermal_EC": 0.015,
